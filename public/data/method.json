 "limitations": [
  {
   "title": "Small pressure samples",
   "detail": "Even eligible players have 120-650 pressure balls; bootstrap rank intervals are wide, so read P(top 10) alongside the rank."
  },
  {
   "title": "First-innings win probability is uncertain",
   "detail": "Without a target the WP model is weaker in innings 1 (test AUC 0.66) than in the chase."
  },
  {
   "title": "Early wickets carry real leverage",
   "detail": "In this data an early wicket moves win probability as much as many death-over balls, so powerplay balls are often pressure balls. The rule-based sensitivity test shows how rankings change without this."
  },
  {
   "title": "Tiers use the full period",
   "detail": "Threat tiers are descriptive and built on all seasons, so an opponent's tier reflects the whole 2022-2026 window, not form on the day."
  },
  {
   "title": "Mixed competition strength",
   "detail": "International matches include associate sides (A-team cups are excluded). Opposition Elo adjusts the expected values, and each top-10 card shows the share of pressure balls against bottom-quartile Elo sides."
  },
  {
   "title": "No fielding, venue or ball-tracking data",
   "detail": "Fielding, pitch and venue effects are only partly absorbed by state expectations; bowl_speed was dropped (about 39% zeros)."
  }
